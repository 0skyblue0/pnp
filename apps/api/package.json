{
  "name": "@pnp/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "npm run build -w @pnp/shared && tsx watch src/index.ts",
    "import:daily-operation": "tsx src/modules/daily-log/excel-import/daily-operation-excel-import.cli.ts",
    "lint": "eslint .",
    "prisma:generate": "prisma generate",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@fastify/cookie": "^10.0.1",
    "@fastify/cors": "^10.0.1",
    "@pnp/shared": "file:../../packages/shared",
    "@prisma/client": "^6.6.0",
    "bcryptjs": "^3.0.2",
    "fastify": "^5.3.2",
    "pino": "^9.6.0",
    "xlsx": "^0.18.5",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.15.3",
    "prisma": "^6.6.0",
    "testcontainers": "^11.14.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  }
}
