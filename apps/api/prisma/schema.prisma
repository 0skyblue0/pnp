generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id               Int               @id @default(autoincrement())
  name             String            @db.VarChar(80)
  category         String?           @db.VarChar(40)
  isSeasonal       Boolean           @default(false) @map("is_seasonal")
  seasonStart      DateTime?         @map("season_start") @db.Date
  seasonEnd        DateTime?         @map("season_end") @db.Date
  isActive         Boolean           @default(true) @map("is_active")
  sortOrder        Int               @default(0) @map("sort_order")
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime          @default(now()) @map("updated_at") @db.Timestamptz(6)
  stockouts        StockoutLog[]
  tastings         TastingLog[]
  reservationItems ReservationItem[]
  productionLots   ProductionLot[]

  @@index([sortOrder], map: "idx_product_sort_order")
  @@map("product")
}

model Staff {
  id                Int                @id @default(autoincrement())
  username          String             @unique @db.VarChar(40)
  displayName       String?            @map("display_name") @db.VarChar(40)
  passwordHash      String             @map("password_hash") @db.VarChar(80)
  role              String?            @db.VarChar(15)
  isActive          Boolean            @default(true) @map("is_active")
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  customerResponses CustomerResponse[]
  auditLogs         AuditLog[]

  @@map("staff")
}

model DailyLog {
  id             BigInt             @id @default(autoincrement())
  date           DateTime           @unique @db.Date
  weatherSummary String?            @map("weather_summary") @db.VarChar(80)
  notes          String?            @db.Text
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime           @default(now()) @map("updated_at") @db.Timestamptz(6)
  congestionLogs CongestionLog[]
  tastingLogs    TastingLog[]
  responses      CustomerResponse[]

  @@map("daily_log")
}

model CongestionLog {
  id               BigInt   @id @default(autoincrement())
  dailyLogId       BigInt   @map("daily_log_id")
  timeSlotStart    DateTime @map("time_slot_start") @db.Time(6)
  timeSlotEnd      DateTime @map("time_slot_end") @db.Time(6)
  level            Int?     @db.SmallInt
  queueInside      Boolean  @default(false) @map("queue_inside")
  queueOutside     Boolean  @default(false) @map("queue_outside")
  estLostCustomers Int      @default(0) @map("est_lost_customers")
  dailyLog         DailyLog @relation(fields: [dailyLogId], references: [id], onDelete: Cascade)

  @@map("congestion_log")
}

model TastingLog {
  id              BigInt   @id @default(autoincrement())
  dailyLogId      BigInt   @map("daily_log_id")
  productId       Int      @map("product_id")
  recommended     Boolean  @default(false)
  convertedToSale Boolean? @map("converted_to_sale")
  note            String?  @db.Text
  dailyLog        DailyLog @relation(fields: [dailyLogId], references: [id], onDelete: Cascade)
  product         Product  @relation(fields: [productId], references: [id])

  @@map("tasting_log")
}

model StockoutLog {
  id                   BigInt   @id @default(autoincrement())
  productId            Int      @map("product_id")
  date                 DateTime @db.Date
  sequence             Int      @db.SmallInt
  stockoutAt           DateTime @map("stockout_at") @db.Timestamptz(6)
  inquiryAfterStockout String?  @map("inquiry_after_stockout") @db.VarChar(10)
  discardQty           Int      @default(0) @map("discard_qty")
  discardReason        String?  @map("discard_reason") @db.Text
  relatedLotId         BigInt?  @map("related_lot_id")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  product              Product  @relation(fields: [productId], references: [id])

  @@index([date, productId], map: "idx_stockout_date_product")
  @@map("stockout_log")
}

model ProductionLot {
  id         BigInt   @id @default(autoincrement())
  productId  Int      @map("product_id")
  producedAt DateTime @map("produced_at") @db.Timestamptz(6)
  lotType    String?  @map("lot_type") @db.VarChar(10)
  quantity   Int
  staffNote  String?  @map("staff_note") @db.Text
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  product    Product  @relation(fields: [productId], references: [id])

  @@index([producedAt, productId], map: "idx_production_lot_date")
  @@map("production_lot")
}

model AbsentInquiry {
  id          BigInt   @id @default(autoincrement())
  productName String   @map("product_name") @db.VarChar(80)
  productId   Int?     @map("product_id")
  date        DateTime @db.Date
  count       Int      @default(1)
  note        String?  @db.Text

  @@unique([productName, date])
  @@map("absent_inquiry")
}

model Reservation {
  id             BigInt            @id @default(autoincrement())
  contactToken   String            @map("contact_token") @db.VarChar(64)
  customerName   String?           @map("customer_name") @db.VarChar(80)
  contactPhone   String?           @map("contact_phone") @db.VarChar(40)
  customerCardId String?           @map("customer_card_id") @db.Uuid
  pickupAt       DateTime          @map("pickup_at") @db.Timestamptz(6)
  status         String            @default("PENDING") @db.VarChar(15)
  isPaid         Boolean           @default(false) @map("is_paid")
  isCut          Boolean           @default(false) @map("is_cut")
  isBag          Boolean           @default(false) @map("is_bag")
  cancelReason   String?           @map("cancel_reason") @db.Text
  purpose        String?           @db.VarChar(10)
  allergyNote    String?           @map("allergy_note") @db.Text
  memo           String?           @db.Text
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt    DateTime?         @map("completed_at") @db.Timestamptz(6)
  items          ReservationItem[]

  @@index([pickupAt, status], map: "idx_reservation_pickup")
  @@map("reservation")
}

model RegularCustomer {
  id           BigInt   @id @default(autoincrement())
  customerName String   @map("customer_name") @db.VarChar(80)
  contactPhone String?  @map("contact_phone") @db.VarChar(40)
  fixedMemo    String   @map("fixed_memo") @db.Text
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@index([customerName, contactPhone], map: "idx_regular_customer_lookup")
  @@map("regular_customer")
}

model PrepaidCustomer {
  id           BigInt               @id @default(autoincrement())
  customerName String               @map("customer_name") @db.VarChar(80)
  contactPhone String?              @map("contact_phone") @db.VarChar(40)
  memo         String?              @db.Text
  ledgerType   String               @default("GENERAL") @map("ledger_type") @db.VarChar(20)
  sharedLimit  Int?                 @map("shared_limit")
  isActive     Boolean              @default(true) @map("is_active")
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime             @default(now()) @map("updated_at") @db.Timestamptz(6)
  transactions PrepaidTransaction[]
  participants PrepaidParticipant[]

  @@index([customerName, contactPhone], map: "idx_prepaid_customer_lookup")
  @@map("prepaid_customer")
}

model PrepaidTransaction {
  id         BigInt          @id @default(autoincrement())
  customerId BigInt          @map("customer_id")
  participantId BigInt?      @map("participant_id")
  type       String          @db.VarChar(10)
  amount     Int
  note       String?         @db.Text
  occurredAt DateTime        @default(now()) @map("occurred_at") @db.Timestamptz(6)
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  customer   PrepaidCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  participant PrepaidParticipant? @relation(fields: [participantId], references: [id], onDelete: SetNull)

  @@index([customerId, occurredAt], map: "idx_prepaid_transaction_customer_date")
  @@index([participantId], map: "idx_prepaid_transaction_participant")
  @@map("prepaid_transaction")
}

model PrepaidParticipant {
  id              BigInt               @id @default(autoincrement())
  customerId      BigInt               @map("customer_id")
  participantName String               @map("participant_name") @db.VarChar(80)
  phoneLast4      String               @map("phone_last4") @db.VarChar(4)
  limitAmount     Int                  @map("limit_amount")
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime             @default(now()) @map("updated_at") @db.Timestamptz(6)
  customer        PrepaidCustomer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  transactions    PrepaidTransaction[]

  @@unique([customerId, phoneLast4], map: "uq_prepaid_participant_customer_phone")
  @@index([customerId], map: "idx_prepaid_participant_customer")
  @@map("prepaid_participant")
}

model ReservationItem {
  id            BigInt      @id @default(autoincrement())
  reservationId BigInt      @map("reservation_id")
  productId     Int         @map("product_id")
  quantity      Int
  cuttingOption String      @default("NONE") @map("cutting_option") @db.VarChar(20)
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  product       Product     @relation(fields: [productId], references: [id])

  @@index([productId], map: "idx_reservation_item_product")
  @@map("reservation_item")
}

model CustomerResponse {
  id                BigInt             @id @default(autoincrement())
  date              DateTime           @db.Date
  dailyLogId        BigInt?            @map("daily_log_id")
  customerCardId    String?            @map("customer_card_id") @db.Uuid
  criterionId       Int                @map("criterion_id")
  majorCriterionId  Int                @map("major_criterion_id")
  middleCriterionId Int?               @map("middle_criterion_id")
  minorCriterionId  Int?               @map("minor_criterion_id")
  shortSummary      String?            @map("short_summary") @db.VarChar(200)
  fullText          String?            @map("full_text") @db.Text
  llmSuggestionId   BigInt?            @map("llm_suggestion_id")
  llmAssisted       Boolean            @default(false) @map("llm_assisted")
  createdBy         Int?               @map("created_by")
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  dailyLog          DailyLog?          @relation(fields: [dailyLogId], references: [id])
  creator           Staff?             @relation(fields: [createdBy], references: [id])
  criterion         ResponseCriterion  @relation("SelectedResponseCriterion", fields: [criterionId], references: [id])
  majorCriterion    ResponseCriterion  @relation("MajorResponseCriterion", fields: [majorCriterionId], references: [id])
  middleCriterion   ResponseCriterion? @relation("MiddleResponseCriterion", fields: [middleCriterionId], references: [id])
  minorCriterion    ResponseCriterion? @relation("MinorResponseCriterion", fields: [minorCriterionId], references: [id])

  @@index([date, majorCriterionId], map: "idx_response_date_major")
  @@index([criterionId], map: "idx_response_criterion")
  @@map("customer_response")
}

model ResponseCriterion {
  id                Int                 @id @default(autoincrement())
  parentId          Int?                @map("parent_id")
  depth             Int                 @db.SmallInt
  name              String              @db.VarChar(80)
  sortOrder         Int                 @default(0) @map("sort_order")
  isActive          Boolean             @default(true) @map("is_active")
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime            @default(now()) @map("updated_at") @db.Timestamptz(6)
  parent            ResponseCriterion?  @relation("ResponseCriterionChildren", fields: [parentId], references: [id])
  children          ResponseCriterion[] @relation("ResponseCriterionChildren")
  selectedResponses CustomerResponse[]  @relation("SelectedResponseCriterion")
  majorResponses    CustomerResponse[]  @relation("MajorResponseCriterion")
  middleResponses   CustomerResponse[]  @relation("MiddleResponseCriterion")
  minorResponses    CustomerResponse[]  @relation("MinorResponseCriterion")

  @@index([parentId, sortOrder], map: "idx_response_criterion_parent_order")
  @@index([depth, isActive], map: "idx_response_criterion_depth_active")
  @@map("response_criterion")
}

model Notification {
  id        BigInt    @id @default(autoincrement())
  type      String    @db.VarChar(40)
  title     String    @db.VarChar(120)
  body      String?   @db.Text
  link      String?   @db.VarChar(200)
  severity  String?   @db.VarChar(10)
  isRead    Boolean   @default(false) @map("is_read")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  readAt    DateTime? @map("read_at") @db.Timestamptz(6)

  @@index([isRead, createdAt], map: "idx_notification_unread")
  @@map("notification")
}

model AnnualSchedule {
  id        BigInt   @id @default(autoincrement())
  date      DateTime @db.Date
  title     String   @db.VarChar(120)
  note      String?  @db.Text
  tone      String   @default("notice") @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([date], map: "idx_annual_schedule_date")
  @@map("annual_schedule")
}

model AnnualGoalNotice {
  id             BigInt   @id @default(autoincrement())
  category       String   @db.VarChar(20)
  title          String   @db.VarChar(120)
  value          String   @db.VarChar(200)
  note           String?  @db.Text
  targetYear     Int?     @map("target_year") @db.SmallInt
  monthlyTargets Json?    @map("monthly_targets")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@index([category, createdAt], map: "idx_annual_goal_notice_category")
  @@index([category, targetYear], map: "idx_annual_goal_notice_category_year")
  @@map("annual_goal_notice")
}

model DailyOperationRecord {
  id               BigInt   @id @default(autoincrement())
  date             DateTime @unique @db.Date
  draft            Json
  productRows      Json     @map("product_rows")
  channelRows      Json     @map("channel_rows")
  staffSpecialRows Json     @map("staff_special_rows")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@index([date], map: "idx_daily_operation_record_date")
  @@map("daily_operation_record")
}

model AuditLog {
  id          BigInt   @id @default(autoincrement())
  staffId     Int?     @map("staff_id")
  action      String?  @db.VarChar(20)
  entity      String?  @db.VarChar(40)
  entityId    String?  @map("entity_id") @db.VarChar(40)
  beforeValue Json?    @map("before_value")
  afterValue  Json?    @map("after_value")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  staff       Staff?   @relation(fields: [staffId], references: [id])

  @@map("audit_log")
}
